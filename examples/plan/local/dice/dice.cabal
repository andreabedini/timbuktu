cabal-version: 3.0
name:          dice
version:       0.1.0.0
synopsis:      Rolls dice, with random from Hackage
license:       NONE
build-type:    Simple

library
  exposed-modules:  Dice
  hs-source-dirs:   src
  build-depends:    base, random >=1.2 && <1.4
  default-language: Haskell2010

executable dice
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    base, dice
  default-language: Haskell2010
