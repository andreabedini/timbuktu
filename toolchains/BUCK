something(name = "something")

system_cxx_toolchain(
    name = "cxx",
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

system_python_toolchain(
    name = "python",
    visibility = ["PUBLIC"],
)

system_python_bootstrap_toolchain(
    name = "python_bootstrap",
    visibility = ["PUBLIC"],
)

download_ghc_distribution(
    name = "ghc-9.12.2",
    version = "9.12.2",
)

haskell_toolchain(
    name = "haskell",
    distribution = ":ghc-9.12.2",
    visibility = ["PUBLIC"],
)

download_cabal_distribution(
    name = "cabal-3.14.2.0",
    version = "3.14.2.0",
)

cabal_toolchain(
    name = "cabal",
    distribution = ":cabal-3.14.2.0",
    visibility = ["PUBLIC"],
)

# The toolchain of the cabal_simple rules (see root//rules/haskell/cabal).
# This one uses whatever GHC is in PATH.
system_ghc_toolchain(
    name = "ghc",
    visibility = ["PUBLIC"],
)

# The same from a binary distribution, to select with
# `--config cabal.ghc_toolchain=toolchains//:ghc-9.12.2-bindist`
bindist_ghc_toolchain(
    name = "ghc-9.12.2-bindist",
    distribution = ":ghc-9.12.2",
    visibility = ["PUBLIC"],
)
