"""
Generate cabal_simple targets from a .cabal file.

    buck2 bxl //rules/haskell/cabal/generate.bxl:generate -- --cabal-file examples/cabal_simple/hello/hello.cabal
    buck2 bxl //rules/haskell/cabal/generate.bxl:generate -- --sdist //examples/cabal_simple/alex:alex-3.5.1.0

It prints the path of a BUCK file: copy it where it belongs and format it
with buildifier.

    buck2 bxl //rules/haskell/cabal/generate.bxl:check -- --against //examples/cabal_simple/hello --cabal-file examples/cabal_simple/hello/hello.cabal

compares what would be generated with the targets of a package instead,
attribute by attribute, and fails saying what differs (see `_IGNORED` for
what is not compared). That is how the transcriptions in
examples/cabal_simple are checked (examples/cabal_simple/tests/generate.sh). The conditionals of the package description are resolved
for the GHC of toolchains//:haskell, this machine's platform and `--flags`
(the defaults of the package otherwise). See generate.bzl for how
components and dependencies become targets.

Options:
  --cabal-file PATH   a .cabal file in the repository; the BUCK file is to
                      go next to it, with the package's files as `srcs`
  --sdist TARGET      a hackage_package target (an unpacked sdist); the
                      BUCK file has its hackage_package and uses it as `srcs`
  --flags '+a -b'     flags of the package
  --tests false       no targets for the test suites
  --dep PKG[:LIB]=TARGET    the target of a library of another package
  --tool PKG:EXE=TARGET     the target of an executable of another package
  --compiler-prefix LABEL   e.g. //examples/cabal_simple/ghc: to use those
                            targets for the packages of the compiler, rather
                            than haskell_unit targets of its own
  --against PACKAGE   (check) the package to compare with
"""

load("//rules/haskell:toolchain.bzl", "GhcToolchainInfo")
load(":describe.bzl", "describe_package")
load(":fields.bzl", "attr_name")
load(":generate.bzl", "RULE_FIELDS", "buck_file", "glob_srcs", "label_srcs", "package_targets")

def _pairs(items: list[str], option: str) -> dict[str, str]:
    out = {}
    for item in items:
        key, sep, value = item.partition("=")
        if not sep:
            fail("--{} wants KEY=TARGET, not `{}`".format(option, item))
        out[key] = value
    return out

def _actions(ctx: bxl.Context) -> (AnalysisActions, RunInfo):
    """The action registry, and the describe_package helper built as a tool
    (an exec dep): with the GHC of the tools, which need not be the one of
    the packages (see toolchains//:haskell). BXL allows one registry, which
    is where exec deps come from."""
    target = ctx.unconfigured_sub_targets("timbuktu//rules/haskell/helpers:describe_package")
    bxl_actions = ctx.bxl_actions(exec_deps = [target])
    return bxl_actions.actions, bxl_actions.exec_deps[target][RunInfo]

def _describe(ctx: bxl.Context, actions: AnalysisActions, helper: RunInfo) -> struct:
    """Run describe_package and list the packages of the compiler."""
    args = ctx.cli_args
    if bool(args.cabal_file) == bool(args.sdist):
        fail("give either --cabal-file or --sdist")

    ghc = ctx.analysis(ctx.configured_targets("toolchains//:haskell")).providers()[GhcToolchainInfo]

    loads = []
    preamble = []
    if args.cabal_file:
        cabal = ctx.fs.source(args.cabal_file)
        source = args.cabal_file
        srcs = glob_srcs()
    else:
        node = ctx.configured_targets(args.sdist)
        cabal = ctx.analysis(node).providers()[DefaultInfo].default_outputs[0]
        source = "the sdist of " + str(node.label.raw_target())
        name = node.label.name
        srcs = label_srcs(":" + name)
        sha256 = node.attrs_eager().sha256.value()
        loads.append('load("@timbuktu//rules/haskell:hackage.bzl", "hackage_package")')
        preamble.append("hackage_package(\n    name = {},\n    sha256 = {},\n)\n".format(repr(name), repr(sha256)))

    description = describe_package(actions, helper, ghc, cabal, args.flags)
    compiler_packages = actions.declare_output("compiler-packages")
    actions.run(
        cmd_args("sh", "-c", 'out=$1; shift; "$@" list --global --simple-output --names-only > "$out"', "--", compiler_packages.as_output(), ghc.ghc_pkg),
        category = "compiler_packages",
        local_only = True,
    )
    return struct(
        description = description,
        compiler_packages = compiler_packages,
        srcs = srcs,
        source = source,
        loads = loads,
        preamble = preamble,
        options = dict(
            deps = _pairs(args.dep, "dep"),
            tools = _pairs(args.tool, "tool"),
            compiler_prefix = args.compiler_prefix,
            tests = args.tests,
        ),
    )

def _generate_impl(ctx: bxl.Context):
    actions, helper = _actions(ctx)
    d = _describe(ctx, actions, helper)
    out = actions.declare_output("BUCK")

    def write(ctx, artifacts, outputs):
        ctx.bxl_actions().actions.write(outputs[out], buck_file(
            artifacts[d.description].read_json(),
            artifacts[d.compiler_packages].read_string().split(),
            d.srcs,
            source = d.source,
            loads = d.loads,
            preamble = d.preamble,
            **d.options
        ))

    actions.dynamic_output(dynamic = [d.description, d.compiler_packages], inputs = [], outputs = [out.as_output()], f = write)
    ctx.output.print(ctx.output.ensure(out).abs_path())

# What the comparison leaves out: where the transcriptions are written
# differently (`srcs`, `cabal_version`, `license_file`), fields that make no
# difference to the build and that they leave out, and what is not a field
# (`visibility`). The order of `build_depends` does not count either.
_IGNORED = [
    "srcs",
    "visibility",
    "cabal_version",
    "license_file",
    "license_files",
    "tested_with",
    "extra_source_files",
    "extra_doc_files",
]

# The values of attributes that are the same as giving none.
_DEFAULTS = {
    "buildable": True,
    "build_type": "Simple",
    "data_dir": ".",
    "exposed": True,
    "hs_source_dirs": ["."],
    "license": "NONE",
    "type": "exitcode-stdio-1.0",
}

def _normal(cell: str, package: str, name: str, value: typing.Any) -> typing.Any:
    """A value as a string or a list of strings, labels absolute (in
    `cell`, the cell of the package)."""
    if type(value) == "list":
        items = [_normal(cell, package, name, v) for v in value]
        return sorted(items) if name == "build_depends" else items
    value = str(value)
    if value.startswith(":"):
        return "{}//{}{}".format(cell, package, value)
    if value.startswith("//"):
        return cell + value
    return value

def _value(cell: str, package: str, name: str, value: typing.Any) -> typing.Any:
    """A value to compare: None when it is the same as giving none."""
    if value in (None, [], "") or (name in _DEFAULTS and _DEFAULTS[name] == value):
        return None
    return _normal(cell, package, name, value)

def _differences(cell: str, package: str, generated: struct, written: dict[str, struct]) -> list[str]:
    out = []
    names = {t.attrs[0][1]: t for t in generated.targets}
    for name, t in names.items():
        if name not in written:
            out.append("{}: generated, not written".format(name))
            continue
        w = written[name]
        if w.rule != t.rule:
            out.append("{}: a {} rather than a {}".format(name, w.rule, t.rule))
            continue
        mine = {k: _value(cell, package, k, v) for k, v in t.attrs}
        keys = {k: None for k in mine.keys() + [attr_name(f, spec) for f, spec in RULE_FIELDS[t.rule].items()]}
        for k in sorted(keys.keys()):
            if k in _IGNORED:
                continue
            theirs = _value(cell, package, k, w.attrs.get(k))
            if mine.get(k) != theirs:
                out.append("{}: {} is {} rather than {}".format(name, k, repr(theirs), repr(mine.get(k))))
    for name, w in written.items():
        if w.rule.startswith("cabal_") and name not in names:
            out.append("{}: written, not generated".format(name))
    units = sorted([name for name, w in written.items() if w.rule == "haskell_unit"])
    if units and units != generated.units:
        out.append("the haskell_unit targets are {} rather than {}".format(units, generated.units))
    return out

def _check_impl(ctx: bxl.Context):
    if not ctx.cli_args.against:
        fail("give --against PACKAGE")
    package = ctx.cli_args.against.removeprefix("root").removeprefix("//").rstrip(":")
    written = {}

    # The name of the root cell, which need not be root.
    cell = "root"
    for node in ctx.uquery().eval("root//{}:".format(package)):
        cell = node.label.cell
        attrs = node.get_attrs()
        written[node.label.name] = struct(rule = node.rule_type.rpartition(":")[2], attrs = attrs)

    actions, helper = _actions(ctx)
    d = _describe(ctx, actions, helper)
    out = actions.declare_output("check")

    def check(ctx, artifacts, outputs):
        generated = package_targets(
            artifacts[d.description].read_json(),
            artifacts[d.compiler_packages].read_string().split(),
            d.srcs,
            **d.options
        )
        differences = _differences(cell, package, generated, written)
        if differences:
            fail("{}: the targets differ from what would be generated:\n  {}".format(package, "\n  ".join(differences)))
        ctx.bxl_actions().actions.write(outputs[out], "{}: the same as generated\n".format(package))

    actions.dynamic_output(dynamic = [d.description, d.compiler_packages], inputs = [], outputs = [out.as_output()], f = check)
    ctx.output.print(ctx.output.ensure(out).abs_path())

_CLI_ARGS = {
    "cabal-file": cli_args.option(cli_args.string()),
    "compiler-prefix": cli_args.option(cli_args.string()),
    "dep": cli_args.list(cli_args.string(), default = []),
    "flags": cli_args.string(default = ""),
    "tests": cli_args.bool(default = True),
    "sdist": cli_args.option(cli_args.string()),
    "tool": cli_args.list(cli_args.string(), default = []),
}

generate = bxl_main(
    impl = _generate_impl,
    cli_args = _CLI_ARGS,
)

check = bxl_main(
    impl = _check_impl,
    cli_args = _CLI_ARGS | {"against": cli_args.option(cli_args.string())},
)
