load("@timbuktu//rules/haskell/cabal:defs.bzl", "cabal_package", "cabal_simple_library", "cabal_simple_test")

# A.chs is a c2hs file: find_modules knows it from Cabal, the rules cannot run c2hs.
cabal_package(name = "p", version = "1", srcs = ["A.chs"])

cabal_simple_library(name = "lib", package = ":p", exposed_modules = ["A"])
