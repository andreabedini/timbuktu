load(":helper.bzl", "haskell_helper")

# The constraint toolchains//:haskell selects the GHC of the tools on (see
# helper.bzl).
constraint_setting(
    name = "helper",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "yes",
    constraint_setting = ":helper",
    visibility = ["PUBLIC"],
)

haskell_helper(
    name = "parse_fields",
    srcs = {
        "Main.hs": "parse_fields.hs",
    },
    toolchain_libs = [
        "base",
        "bytestring",
        "Cabal",
        "Cabal-syntax",
    ],
)

# What generate.bxl in timbuktu//rules/haskell/cabal reads a .cabal file with.
haskell_helper(
    name = "describe_package",
    srcs = {
        "Main.hs": "describe_package.hs",
    },
    link_style = "static",
    toolchain_libs = [
        "base",
        "bytestring",
        "Cabal",
        "Cabal-syntax",
        "directory",
        "filepath",
    ],
    visibility = ["PUBLIC"],
)

