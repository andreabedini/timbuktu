"""
Pin GHC and cabal-install binary distributions from GHCup's metadata.

    buck2 bxl //rules/haskell/ghcup/ghcup.bxl:pin -- --ghc 9.6.7 --cabal 3.14.2.0

It prints the path of a BUCK file: copy it to toolchains/ghcup/BUCK and
make toolchains of its targets in toolchains/BUCK (see defs.bzl). The file
has a ghc_bindist or cabal_bindist for each version, with the URL, sha256
and top directory of its archive for each platform in PLATFORMS of
defs.bzl. The versions already pinned in the package (--package,
toolchains//ghcup by default) are kept as they are; the ones given are
added, or pinned again if they are there.

The metadata is downloaded with curl and turned into JSON with yq, both
taken from PATH: GHCup publishes it in YAML only. yq is mikefarah's (Go,
version 4), not the Python wrapper of jq of the same name.

Options:
  --ghc VERSION         a GHC to pin (repeatable)
  --cabal VERSION       a cabal-install to pin (repeatable)
  --package PACKAGE     where the distributions are pinned, to keep the ones
                        there (default: toolchains//ghcup)
  --metadata-url URL    the metadata (default: METADATA_URL)
"""

load(":defs.bzl", "PLATFORMS")

METADATA_URL = "https://raw.githubusercontent.com/haskell/ghcup-metadata/master/ghcup-0.0.9.yaml"

# GHCup's architecture and OS for each platform of defs.bzl. The archive
# for an OS of any version ("unknown_versioning") is the one taken.
_GHCUP_PLATFORMS = {
    "linux-aarch64": ("A_ARM64", "Linux_UnknownLinux"),
    "linux-x86_64": ("A_64", "Linux_UnknownLinux"),
    "macos-aarch64": ("A_ARM64", "Darwin"),
    "macos-x86_64": ("A_64", "Darwin"),
}

# GHC binary distributions before 9.10 have no lib/settings until
# ./configure (see ghc_bindist in defs.bzl). Checked on the Linux x86_64
# archives of 9.6.7 and 9.8.4 (none) and 9.10.2 and 9.12.2 (there).
_CONFIGURE_BEFORE = [9, 10]

# Our name of a tool, GHCup's, and the macro of defs.bzl.
_TOOLS = {
    "cabal": struct(ghcup = "Cabal", macro = "cabal_bindist", rule = "cabal_distribution"),
    "ghc": struct(ghcup = "GHC", macro = "ghc_bindist", rule = "ghc_distribution"),
}

def _version_key(version: str) -> list[int]:
    return [int(c) if c.isdigit() else 0 for c in version.split(".")]

def _bindists(tool: str, version: str, metadata: dict) -> dict[str, dict[str, str]]:
    versions = metadata[_TOOLS[tool].ghcup]
    if version not in versions:
        fail("GHCup has no {} {}. It has: {}".format(tool, version, ", ".join(sorted(versions.keys(), key = _version_key))))
    archs = versions[version]["viArch"]
    out = {}
    for platform in PLATFORMS:
        arch, os = _GHCUP_PLATFORMS[platform]
        d = archs.get(arch, {}).get(os, {}).get("unknown_versioning")
        if not d:
            # Left out: on that platform the select of the archive fails.
            continue
        bindist = {"sha256": d["dlHash"], "url": d["dlUri"]}
        if d.get("dlSubdir"):
            bindist["strip_prefix"] = d["dlSubdir"]
        out[platform] = bindist
    if not out:
        fail("GHCup has {} {} for none of {}".format(tool, version, ", ".join(PLATFORMS.keys())))
    return out

def _pinned(ctx: bxl.Context, package: str) -> dict[str, dict[str, struct]]:
    """The distributions pinned in `package`, by tool and version."""
    pinned = {tool: {} for tool in _TOOLS}
    if not ctx.fs.exists(package.replace("//", "/", 1) + "/BUCK"):
        return pinned
    for node in ctx.uquery().eval("kind('_distribution$', {}:)".format(package)):
        rule = node.rule_type.rpartition(":")[2]
        for tool, t in _TOOLS.items():
            if rule == t.rule:
                attrs = node.get_attrs()
                pinned[tool][attrs["version"]] = struct(
                    bindists = attrs["bindists"],
                    configure = attrs.get("configure", False),
                )
    return pinned

def _starlark(value, indent: str) -> str:
    """`value` written the way buildifier would."""
    if type(value) == "dict":
        if not value:
            return "{}"
        inner = indent + "    "
        return "{\n" + "".join([
            "{}{}: {},\n".format(inner, repr(k), _starlark(v, inner))
            for k, v in value.items()
        ]) + indent + "}"
    return repr(value)

def _buck_file(pinned: dict[str, dict[str, struct]]) -> str:
    lines = [
        "# @generated by `buck2 bxl //rules/haskell/ghcup/ghcup.bxl:pin` from GHCup's",
        "# metadata: binary distributions of GHC and cabal-install, pinned. To add or",
        "# pin again a version, run it with `--ghc VERSION` or `--cabal VERSION` and",
        "# copy the file it prints here; the versions here are kept.",
        "",
        'load("@root//rules/haskell/ghcup:defs.bzl", "cabal_bindist", "ghc_bindist")',
    ]
    for tool in sorted(_TOOLS.keys()):
        for version in sorted(pinned[tool].keys(), key = _version_key):
            p = pinned[tool][version]
            lines.append("")
            lines.append("{}(".format(_TOOLS[tool].macro))
            lines.append("    name = {},".format(repr("{}-{}".format(tool, version))))
            lines.append("    version = {},".format(repr(version)))
            lines.append("    bindists = {},".format(_starlark(p.bindists, "    ")))
            if p.configure:
                lines.append("    configure = True,")
            lines.append(")")
    return "\n".join(lines) + "\n"

def _pin_impl(ctx: bxl.Context):
    args = ctx.cli_args
    current = _pinned(ctx, args.package)
    actions = ctx.bxl_actions().actions

    metadata = actions.declare_output("metadata.json")
    script = actions.write("metadata.sh", [
        "set -eu",
        "yaml=\"${BUCK_SCRATCH_PATH:-${TMPDIR:-/tmp}}/ghcup.yaml\"",
        "mkdir -p \"$(dirname \"$yaml\")\"",
        "curl -fsSL \"$1\" -o \"$yaml\"",
        "yq -o json '.ghcupDownloads | {\"GHC\": .GHC, \"Cabal\": .Cabal}' \"$yaml\" > \"$2\"",
    ])
    actions.run(
        cmd_args("/bin/sh", script, args.metadata_url, metadata.as_output()),
        category = "ghcup_metadata",
        # It downloads, with tools from PATH.
        local_only = True,
    )

    out = actions.declare_output("BUCK")

    def write(ctx, artifacts, outputs):
        m = artifacts[metadata].read_json()

        # A copy: what was frozen when the script was evaluated cannot change.
        pinned = {tool: dict(versions) for tool, versions in current.items()}
        for version in args.ghc:
            pinned["ghc"][version] = struct(
                bindists = _bindists("ghc", version, m),
                configure = _version_key(version)[:2] < _CONFIGURE_BEFORE,
            )
        for version in args.cabal:
            pinned["cabal"][version] = struct(
                bindists = _bindists("cabal", version, m),
                configure = False,
            )
        ctx.bxl_actions().actions.write(outputs[out], _buck_file(pinned))

    actions.dynamic_output(dynamic = [metadata], inputs = [], outputs = [out.as_output()], f = write)
    ctx.output.print(ctx.output.ensure(out).abs_path())

pin = bxl_main(
    impl = _pin_impl,
    cli_args = {
        "cabal": cli_args.list(cli_args.string(), default = []),
        "ghc": cli_args.list(cli_args.string(), default = []),
        "metadata-url": cli_args.string(default = METADATA_URL),
        "package": cli_args.string(default = "toolchains//ghcup"),
    },
)
