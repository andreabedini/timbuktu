"""
Make a build plan and write it out as a BUCK file.

    buck2 bxl //rules/haskell/cabal_install/plan.bxl:generate -- --target shake --index-state 2026-06-01T00:00:00Z

runs cabal-solver-plan (see plan.bzl: the GHC of toolchains//:haskell, the
Hackage index of toolchains//:cabal-solver-plan) and prints the path of a
BUCK file with a target for each package and unit of the plan (see
plan_targets.bzl). Copy it where it belongs. Its header says how to make it
again.

    buck2 bxl //rules/haskell/cabal_install/plan.bxl:generate -- --local-package examples/plan/local/dice --buck-dir examples/plan/local --index-state 2026-06-01T00:00:00Z

plans for a package in the repository (a directory with a .cabal file, as
in the `packages` of a cabal.project), and for what it needs from Hackage.
A local package becomes cabal_simple targets, made from what
describe_package prints for its .cabal file with the flags of the plan; its
sources are a `glob` of its directory, so the BUCK file has to be copied to
the directory `--buck-dir` names, which has to be the package's or one
above it, with no BUCK file in between. That directory needs a BUCK file
already (an empty one the first time), for buck2 to read the .cabal files.

    buck2 bxl //rules/haskell/cabal_install/plan.bxl:generate -- --plan-file path/to/plan.json

writes out a plan made before instead, without the solver.

A local package can also be one of another cell, whose BUCK files are not
this one's: `--local-package CELL//DIR=TARGET`, where TARGET is its
cabal_package target there (the plan of that cell has one for each of its
local packages). Its components here use TARGET rather than a glob.

Options:
  --target PKG          a package to plan for (more than one: repeat it)
  --local-package DIR   a package in the repository, always planned for
                        (more than one: repeat it); CELL//DIR=TARGET for
                        one of another cell, with its cabal_package TARGET
  --buck-dir DIR        where the BUCK file goes; needed with local packages
  --index-state TIME    leave out what was uploaded after, e.g.
                        2026-06-01T00:00:00Z
  --constraint C        as in cabal.project, e.g. 'aeson >= 2.2'; 'PKG test'
                        plans the test suites of PKG too
  --flag PKG:FLAGS      flags of a package, e.g. 'aeson:-ordered-keymap'
  --pkgconfig NAME=TARGET   the target of a C library of the pkgconfig-depends
                        of a local package, by its pkg-config name (it goes
                        to cxx_deps; more than one: repeat it)
  --extra-library NAME=TARGET   the target of a library of the
                        extra-libraries of a local package, by its name: it
                        goes to cxx_deps rather than being linked with -l
                        (more than one: repeat it)
  --generated DIR=TARGET    a directory of a local package that TARGET makes,
                        e.g. Haskell from an IDL: the components that use it
                        see it in place of what the glob finds there (it
                        goes to `generated`, see generate.bzl; more than
                        one: repeat it); CELL//DIR in another cell
  --as-simple PKG       a local package of another build type whose Setup.hs
                        only finds C or C++ libraries, which --pkgconfig or
                        --extra-library targets provide instead: it is built
                        as Simple (more than one: repeat it)
  --plan-file PATH      a plan in the repository, rather than --target,
                        --index-state, --constraint and --flag
"""

load("//rules/haskell:toolchain.bzl", "GhcToolchainInfo")
load("//rules/haskell/cabal:describe.bzl", "describe_package")
load(":plan.bzl", "solve")
load(":plan_format.bzl", "decode_plan")
load(":plan_targets.bzl", "buck_file")
load(":solver_toolchain.bzl", "CabalSolverPlanInfo")

def _quote(arg: str) -> str:
    for c in arg.elems():
        if not (c.isalnum() or c in "-_.:/=+@"):
            return "'" + arg.replace("'", "'\\''") + "'"
    return arg

def _command(args: typing.Any) -> str:
    words = ["buck2", "bxl", "timbuktu//rules/haskell/cabal_install/plan.bxl:generate", "--"]
    for local in args.local_package:
        words.extend(["--local-package", local])
    for p in args.pkgconfig:
        words.extend(["--pkgconfig", p])
    for e in args.extra_library:
        words.extend(["--extra-library", e])
    for g in args.generated:
        words.extend(["--generated", g])
    for p in args.as_simple:
        words.extend(["--as-simple", p])
    if args.buck_dir:
        words.extend(["--buck-dir", args.buck_dir])
    if args.plan_file:
        words.extend(["--plan-file", args.plan_file])
    else:
        for target in args.target:
            words.extend(["--target", target])
        words.extend(["--index-state", args.index_state])
        for c in args.constraint:
            words.extend(["--constraint", c])
        for f in args.flag:
            words.extend(["--flag", f])
    return " ".join([_quote(w) for w in words])

def _flags(items: list[str]) -> dict[str, str]:
    out = {}
    for item in items:
        pkg, sep, flags = item.partition(":")
        if not sep or not pkg:
            fail("--flag wants PKG:FLAGS, not `{}`".format(item))
        out[pkg] = (out[pkg] + " " + flags) if pkg in out else flags
    return out

def _targets(option: str, items: list[str]) -> dict[str, str]:
    out = {}
    for item in items:
        name, sep, target = item.partition("=")
        if not sep or not name or not target:
            fail("{} wants NAME=TARGET, not `{}`".format(option, item))
        out[name] = target
    return out

def _pkgconfig(items: list[str]) -> dict[str, str]:
    return _targets("--pkgconfig", items)

def _normal_dir(path: str) -> str:
    """A directory of the repository as buck2 wants it: no `./`, no trailing
    `/`, and "" for the root."""
    return "/".join([part for part in path.split("/") if part not in ("", ".")])

def _join(dir: str, rest: str) -> str:
    return dir + "/" + rest if dir else rest

def _local_packages(ctx: bxl.Context) -> list[struct]:
    """The local packages: their directories, relative to the root of the
    project, .cabal files, and where they are from the BUCK file (or their
    cabal_package target, for one of another cell)."""
    args = ctx.cli_args
    if not args.local_package:
        if args.generated:
            fail("--generated is for a directory of a --local-package")
        return []
    here = [p for p in args.local_package if "=" not in p]
    buck_dir = None
    if here:
        if args.buck_dir == None:
            fail("--local-package needs --buck-dir, the directory the BUCK file goes to")
        buck_dir = _normal_dir(args.buck_dir)

        # NOTE: buck2 only makes an artifact of a file in a package: the
        # .cabal files are inputs of the solver and of describe_package.
        if not ctx.fs.exists(_join(buck_dir, "BUCK")):
            fail("{} has no BUCK file yet: create an empty one, the generated file goes there".format(buck_dir or "the root"))
    out = []
    for item in args.local_package:
        path, sep, package_target = item.partition("=")
        if sep:
            # A package of another cell, with its cabal_package there.
            if "//" not in path or not package_target:
                fail("--local-package {}: one of another cell is CELL//DIR=TARGET".format(item))
            cell, _, dir = path.partition("//")
            cell_path = cell + "//" + _normal_dir(dir)
            root = None
        else:
            path = _normal_dir(path)
            if buck_dir and path != buck_dir and not path.startswith(buck_dir + "/"):
                fail("{} is not in {}: a BUCK file there cannot glob its files".format(path, buck_dir))
            root = path.removeprefix(buck_dir).removeprefix("/") or None
            if root:
                parts = root.split("/")
                for n in range(1, len(parts) + 1):
                    d = _join(buck_dir, "/".join(parts[:n]))
                    if ctx.fs.exists(d + "/BUCK"):
                        fail("{} has a BUCK file, which would keep the files below it from a glob in {}".format(d, buck_dir or "the root"))
            cell_path = path
            package_target = None
        # The paths of the root cell without it, whatever it is called:
        # `root//` would be this cell's own root.
        cabal_files = [
            str(e) if sep else str(e).partition("//")[2]
            for e in ctx.fs.list(cell_path)
            if str(e).endswith(".cabal")
        ]
        cabal_files = [f for f in cabal_files if ctx.fs.is_file(f)]
        if len(cabal_files) != 1:
            fail("{} has {} .cabal files, not one".format(path, len(cabal_files)))
        out.append(struct(
            path = _normal_dir(str(ctx.fs.project_rel_path(cell_path))) if cell_path else "",
            root = root,
            cabal = ctx.fs.source(cabal_files[0]),
            generated = {},
            package_target = package_target,
        ))

    # Each directory of --generated goes to the local package it is in.
    for item in args.generated:
        dir, sep, target = item.partition("=")
        if not sep or not dir or not target:
            fail("--generated wants DIR=TARGET, not `{}`".format(item))
        dir = _normal_dir(str(ctx.fs.project_rel_path(dir if "//" in dir else _normal_dir(dir))))
        owners = [local for local in out if not local.path or dir.startswith(local.path + "/")]
        if not owners:
            fail("--generated {}: {} is not in a directory of --local-package".format(item, dir))
        owner = sorted(owners, key = lambda local: len(local.path))[-1]
        owner.generated[dir.removeprefix(owner.path).removeprefix("/")] = target
    return out

def _plan(ctx: bxl.Context, actions: AnalysisActions, ghc: GhcToolchainInfo, local_packages: list[struct]) -> (Artifact, str):
    args = ctx.cli_args
    if args.plan_file:
        if args.target or args.index_state or args.constraint or args.flag:
            fail("--plan-file is a plan made already: it takes no --target, --index-state, --constraint or --flag")
        return ctx.fs.source(args.plan_file), args.plan_file
    if not args.index_state or not (args.target or local_packages):
        fail("give the packages to plan for (--target, --local-package) and an --index-state, or a --plan-file")
    solver = ctx.analysis(ctx.configured_targets("toolchains//:cabal-solver-plan")).providers()[CabalSolverPlanInfo]
    plan = solve(actions, solver, ghc, struct(
        targets = args.target,
        index_state = args.index_state,
        constraints = args.constraint,
        flags = _flags(args.flag),
        # The C libraries given with --pkgconfig are the solver's pkg-config
        # modules, of any version: their targets provide them.
        args = ["--with-pkg-config-module=" + name for name in _pkgconfig(args.pkgconfig)],
        local_packages = local_packages,
    ))
    return plan, "the plan for " + " ".join(args.target + args.local_package)

def _actions(ctx: bxl.Context) -> (AnalysisActions, RunInfo):
    """The action registry, and the describe_package helper built as a tool
    (an exec dep): with the GHC of the tools, which need not be the one of
    the packages (see toolchains//:haskell). BXL allows one registry, which
    is where exec deps come from."""
    target = ctx.unconfigured_sub_targets("timbuktu//rules/haskell/helpers:describe_package")
    bxl_actions = ctx.bxl_actions(exec_deps = [target])
    return bxl_actions.actions, bxl_actions.exec_deps[target][RunInfo]

def _generate_impl(ctx: bxl.Context):
    actions, describer = _actions(ctx)
    ghc = ctx.analysis(ctx.configured_targets("toolchains//:haskell")).providers()[GhcToolchainInfo]
    local_packages = _local_packages(ctx)
    plan, where = _plan(ctx, actions, ghc, local_packages)
    helper = describer if local_packages else None
    command = _command(ctx.cli_args)
    pkgconfig = _pkgconfig(ctx.cli_args.pkgconfig)
    extra_libraries = _targets("--extra-library", ctx.cli_args.extra_library)
    as_simple = ctx.cli_args.as_simple
    out = actions.declare_output("BUCK")

    def write(ctx, artifacts, outputs):
        decoded = decode_plan(where, artifacts[plan].read_string())
        actions = ctx.bxl_actions().actions

        # Each local package of the plan, described with the flags the plan
        # gives it: the solver may have chosen other values than the
        # defaults.
        by_path = {local.path: local for local in local_packages}
        described = {}
        for pkg_id, package in decoded["packages"].items():
            if package["src"]["type"] != "local":
                continue
            local = by_path.get(_normal_dir(package["src"]["path"]))
            if not local:
                fail("{}: {} is a local package of the plan, at {}, which is not one given with --local-package".format(where, pkg_id, package["src"]["path"]))
            flags = [u["flags"] for u in decoded["units"].values() if u.get("package") == pkg_id]
            flags = flags[0] if flags else {}
            described[pkg_id] = struct(
                root = local.root,
                generated = local.generated,
                package_target = local.package_target,
                as_simple = package["name"] in as_simple,
                json = describe_package(
                    actions,
                    helper,
                    ghc,
                    local.cabal,
                    " ".join([("+" if v else "-") + f for f, v in flags.items()]),
                    name = pkg_id + ".json",
                ),
            )

        def write_buck(ctx, artifacts, outputs):
            local = {
                pkg_id: struct(description = artifacts[d.json].read_json(), root = d.root, pkgconfig = pkgconfig, generated = d.generated, extra_libraries = extra_libraries, package_target = d.package_target, as_simple = d.as_simple)
                for pkg_id, d in described.items()
            }
            ctx.bxl_actions().actions.write(outputs[out], buck_file(decoded, command, where, local))

        if not described:
            actions.write(outputs[out], buck_file(decoded, command, where))
            return
        actions.dynamic_output(
            dynamic = [d.json for d in described.values()],
            inputs = [],
            outputs = [outputs[out].as_output()],
            f = write_buck,
        )

    actions.dynamic_output(dynamic = [plan], inputs = [], outputs = [out.as_output()], f = write)
    ctx.output.print(ctx.output.ensure(out).abs_path())

generate = bxl_main(
    impl = _generate_impl,
    cli_args = {
        "as-simple": cli_args.list(cli_args.string(), default = []),
        "buck-dir": cli_args.option(cli_args.string()),
        "constraint": cli_args.list(cli_args.string(), default = []),
        "extra-library": cli_args.list(cli_args.string(), default = []),
        "flag": cli_args.list(cli_args.string(), default = []),
        "generated": cli_args.list(cli_args.string(), default = []),
        "index-state": cli_args.option(cli_args.string()),
        "local-package": cli_args.list(cli_args.string(), default = []),
        "pkgconfig": cli_args.list(cli_args.string(), default = []),
        "plan-file": cli_args.option(cli_args.string()),
        "target": cli_args.list(cli_args.string(), default = []),
    },
)
